font=Terminus 9
## Mako configuration file
# GLOBAL CONFIGURATION OPTIONS
max-history=10
sort=-time
# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
# STYLE OPTIONS
width=320
height=100
margin=8
padding=4
border-size=2
border-radius=0
icons=0
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=left
default-timeout=10000
ignore-timeout=0
max-visible=5
layer=overlay
background-color=#c0c0c0
text-color=#000000
border-color=#000000
progress-color=over #808080

[urgency=low]
border-color=#808080
text-color=#808080
default-timeout=2000

[urgency=normal]
border-color=#000000
default-timeout=5000

[urgency=high]
background-color=#000080
text-color=#ffffff
border-color=#000000
default-timeout=0

[category=mpd]
border-color=#000080
default-timeout=2000
group-by=category
